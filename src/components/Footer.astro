---
import { SITE } from '@config';
---
<footer class="border-t border-slate-900/10 dark:border-white/10 mt-16">
  <div class="container py-10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-600 dark:text-slate-300">
    <p>
      © {new Date().getFullYear()} {SITE.name}. All rights reserved.
    </p>
    <div class="flex items-center gap-4">
      <a href={SITE.github} aria-label="GitHub" class="hover:text-primary-600">GitHub</a>
      <a href={SITE.linkedin} aria-label="LinkedIn" class="hover:text-primary-600">LinkedIn</a>
      <a href={`mailto:${SITE.email}`} aria-label="Email" class="hover:text-primary-600">Email</a>
      <a href={SITE.resumeUrl} aria-label="Resume" class="hover:text-primary-600">Resume</a>
    </div>
  </div>
</footer>


