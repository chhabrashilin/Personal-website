---
import { NAV_LINKS, SITE } from '@config';
import ThemeToggle from './ThemeToggle.astro';
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-50 backdrop-blur supports-[backdrop-filter]:bg-white/70 dark:supports-[backdrop-filter]:bg-slate-900/70 border-b border-slate-900/10 dark:border-white/10">
  <nav class="container flex h-16 items-center justify-between" aria-label="Primary">
    <a href="/" class="flex items-center gap-2 underline-accent" aria-label="Home">
      <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--gradient-accent);"></span>
      <span class="font-semibold text-slate-900 dark:text-white">{SITE.name}</span>
    </a>
    <div class="flex items-center gap-6">
      <ul class="hidden md:flex items-center gap-1">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              class={`px-3 py-2 rounded-md text-sm font-medium hover:text-primary-600 underline-accent ${current === link.href ? 'text-primary-600' : 'text-slate-700 dark:text-slate-200'}`}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <a href={SITE.github} class="sr-only">GitHub</a>
    </div>
  </nav>
  <a class="sr-only focus:not-sr-only focus:absolute focus:p-4" href="#content">Skip to content</a>
</header>


