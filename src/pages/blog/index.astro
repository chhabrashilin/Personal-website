---
import Base from '@layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
---
<Base title="Blog" description="Writing on software, ML, and AI.">
  <h1 class="text-2xl font-bold mb-6">Blog</h1>
  <ul class="space-y-4">
    {posts.map((p) => (
      <li class="card p-4">
        <a href={`/blog/${p.slug}`}
          class="flex items-baseline justify-between">
          <span class="font-medium">{p.data.title}</span>
          <span class="text-sm text-slate-500">{new Date(p.data.pubDate).toLocaleDateString()}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>


