---
import Base from '@layouts/Base.astro';
import ProjectCard from '@components/ProjectCard.astro';
import projects from '@data/projects.json';

const tagParam = Astro.url.searchParams.get('tag') || '';
---
<Base title="Projects" description="Selected projects across SWE, ML, AI, and Cloud.">
  <section class="flex flex-col gap-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <h1 class="text-2xl font-bold gradient-text">Projects</h1>
      <div class="flex items-center gap-2">
        <input id="search" type="search" placeholder="Search projects..." class="w-64 max-w-full rounded-md border border-slate-900/10 dark:border-white/10 bg-white dark:bg-slate-900 px-3 py-2 text-sm" aria-label="Search projects" />
        <div class="flex flex-wrap gap-2">
          {['All','SWE','ML','AI','Cloud'].map((t) => (
            <button class={`px-3 py-1.5 text-sm rounded-md border border-slate-900/10 dark:border-white/10 ${tagParam===t ? 'bg-primary-600 text-white' : 'bg-slate-900/5 dark:bg-white/10'}`} data-tag={t} aria-pressed={tagParam===t}>
              {t}
            </button>
          ))}
        </div>
      </div>
    </div>
    <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
  <script>
    const all = JSON.parse('{JSON.stringify(projects)}');
    const grid = document.getElementById('grid');
    const search = document.getElementById('search');
    const buttons = Array.from(document.querySelectorAll('button[data-tag]'));
    function render(items){
      grid.innerHTML = items.map(p => `
        <a href="/projects/${p.slug}" class="card overflow-hidden group" aria-label="Open case study: ${p.title}">
          <div class="aspect-[16/9] w-full overflow-hidden">
            <img src="${p.cover}" alt="${p.title}" loading="lazy" class="h-full w-full object-cover transition group-hover:scale-[1.02]" />
          </div>
          <div class="p-4 flex flex-col gap-3">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">${p.title}</h3>
              <div class="flex gap-2">
                ${p.links.github ? `<a href="${p.links.github}" class="text-slate-600 hover:text-primary-600">GitHub</a>`:''}
                ${p.links.live ? `<a href="${p.links.live}" class="text-slate-600 hover:text-primary-600">Live</a>`:''}
              </div>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-300">${p.impact}</p>
            <div class="flex flex-wrap gap-2">${p.tags.map((t)=>`<span class=\"inline-flex items-center rounded-md border border-slate-900/10 dark:border-white/10 bg-slate-900/5 dark:bg-white/10 px-2 py-1 text-xs font-medium text-slate-700 dark:text-slate-200\">${t}</span>`).join('')}</div>
            ${p.metrics?.length ? `<ul class=\"text-sm text-slate-700 dark:text-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1\">${p.metrics.map(m=>`<li>• ${m}</li>`).join('')}</ul>`: ''}
          </div>
        </a>`).join('');
    }
    function applyFilter(tag, query){
      let items = all;
      if(tag && tag !== 'All'){ items = items.filter(p => p.tags.includes(tag)); }
      if(query){ const q = query.toLowerCase(); items = items.filter(p => `${p.title} ${p.impact} ${p.tech.join(' ')}`.toLowerCase().includes(q)); }
      render(items);
    }
    const urlTag = new URL(window.location.href).searchParams.get('tag') || '';
    applyFilter(urlTag, '');
    buttons.forEach(btn => btn.addEventListener('click', () => {
      buttons.forEach(b=>b.classList.remove('bg-primary-600','text-white'));
      btn.classList.add('bg-primary-600','text-white');
      applyFilter(btn.dataset.tag, search.value);
    }));
    search.addEventListener('input', () => {
      const active = document.querySelector('button[data-tag].bg-primary-600')?.getAttribute('data-tag') || urlTag || '';
      applyFilter(active, search.value);
    });
  </script>
</Base>


