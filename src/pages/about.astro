---
import Base from '@layouts/Base.astro';
---
<Base title="About">
  <h1 class="text-2xl font-bold mb-6">About</h1>
  <div class="prose-custom">
    <p>I love building things that people use. My work blends SWE craft with ML and pragmatic AI.</p>
    <h3>Values</h3>
    <ul>
      <li>Ship outcomes, not buzzwords.</li>
      <li>Clarity and kindness in collaboration.</li>
      <li>Measure, iterate, improve.</li>
    </ul>
    <h3>Skills</h3>
  </div>
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {['SWE','ML','AI','Cloud'].map((s) => (
      <div class="card p-4">
        <div class="flex items-center justify-between"><span class="font-medium">{s}</span><span class="text-sm text-slate-500">Advanced</span></div>
        <div class="mt-2 h-2 rounded bg-slate-900/10 dark:bg-white/10">
          <div class="h-2 rounded" style="width: 80%; background: var(--gradient-accent);"></div>
        </div>
      </div>
    ))}
  </div>
</Base>


